import pygame
import sys

pygame.init()
screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("My First Pygame")

WHITE = (255, 255, 255)
BLUE = (0, 0, 255)

clock = pygame.time.Clock()
running = True

# 🔥 원의 위치 변수 (처음에는 가운데)
x = 400
y = 300

while running:
    # 이벤트 처리
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # 🔥 키 입력 처리 (방향키)
    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT]:
        x -= 10   # 왼쪽
    if keys[pygame.K_RIGHT]:
        x += 10   # 오른쪽
    if keys[pygame.K_UP]:
        y -= 10   # 위
    if keys[pygame.K_DOWN]:
        y += 10   # 아래

    # 화면 초기화
    screen.fill(WHITE)

    # 🔥 바뀐 위치로 원 그리기
    pygame.draw.circle(screen, BLUE, (x, y), 50)

    # 화면 업데이트
    pygame.display.flip()

    # FPS 설정
    clock.tick(60)

pygame.quit()
sys.exit()
