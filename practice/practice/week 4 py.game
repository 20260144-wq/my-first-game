import pygame
import sys
import math

pygame.init()

WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Collision Comparison")

clock = pygame.time.Clock()
font = pygame.font.SysFont(None, 30)

# 색상
GRAY = (150, 150, 150)
RED = (255, 0, 0)
BLUE = (0, 0, 255)
GREEN = (0, 255, 0)
WHITE = (255, 255, 255)

# 이동 사각형
player_rect = pygame.Rect(100, 100, 50, 50)
speed = 5

# 회전 사각형
static_size = 100
static_center = (WIDTH // 2, HEIGHT // 2)
angle = 0
rotation_speed = 1

static_surface = pygame.Surface((static_size, static_size), pygame.SRCALPHA)
pygame.draw.rect(static_surface, GRAY, (0, 0, static_size, static_size))

# =========================
# SAT 함수
# =========================
def project_polygon(axis, points):
    dots = [p[0]*axis[0] + p[1]*axis[1] for p in points]
    return min(dots), max(dots)

def normalize(v):
    length = math.sqrt(v[0]**2 + v[1]**2)
    return (v[0]/length, v[1]/length)

def sat_collision(poly1, poly2):
    axes = []

    for poly in [poly1, poly2]:
        for i in range(len(poly)):
            p1 = poly[i]
            p2 = poly[(i+1) % len(poly)]

            edge = (p2[0]-p1[0], p2[1]-p1[1])
            normal = (-edge[1], edge[0])
            axes.append(normalize(normal))

    for axis in axes:
        min1, max1 = project_polygon(axis, poly1)
        min2, max2 = project_polygon(axis, poly2)

        if max1 < min2 or max2 < min1:
            return False

    return True

running = True
while running:
    clock.tick(60)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # 이동
    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT]:
        player_rect.x -= speed
    if keys[pygame.K_RIGHT]:
        player_rect.x += speed
    if keys[pygame.K_UP]:
        player_rect.y -= speed
    if keys[pygame.K_DOWN]:
        player_rect.y += speed

    # 회전 속도
    if keys[pygame.K_z]:
        rotation_speed = 5
    else:
        rotation_speed = 1

    angle += rotation_speed

    # 회전 사각형
    rotated_surface = pygame.transform.rotate(static_surface, angle)
    rotated_rect = rotated_surface.get_rect(center=static_center)

    # =========================
    # 🔴 AABB 충돌
    # =========================
    aabb_collision = player_rect.colliderect(rotated_rect)

    # =========================
    # 🔵 원 충돌
    # =========================
    player_center = player_rect.center
    player_radius = player_rect.width // 2
    static_radius = static_size // 2

    dx = player_center[0] - static_center[0]
    dy = player_center[1] - static_center[1]
    distance = math.sqrt(dx*dx + dy*dy)

    circle_collision = distance < (player_radius + static_radius)

    # =========================
    # 🟢 OBB 계산
    # =========================
    half = static_size / 2
    corners = [(-half,-half),(half,-half),(half,half),(-half,half)]

    rad = math.radians(angle)
    cos_a = math.cos(rad)
    sin_a = math.sin(rad)

    obb_points = []
    for x,y in corners:
        rx = x*cos_a - y*sin_a
        ry = x*sin_a + y*cos_a
        obb_points.append((static_center[0]+rx, static_center[1]+ry))

    player_poly = [
        (player_rect.left, player_rect.top),
        (player_rect.right, player_rect.top),
        (player_rect.right, player_rect.bottom),
        (player_rect.left, player_rect.bottom)
    ]

    obb_collision = sat_collision(player_poly, obb_points)

    # =========================
    # 화면 그리기
    # =========================
    screen.fill(WHITE)

    # 객체
    pygame.draw.rect(screen, GRAY, player_rect)
    screen.blit(rotated_surface, rotated_rect.topleft)

    # AABB
    pygame.draw.rect(screen, RED, player_rect, 2)
    pygame.draw.rect(screen, RED, rotated_rect, 2)

    # 원
    pygame.draw.circle(screen, BLUE, player_center, player_radius, 2)
    pygame.draw.circle(screen, BLUE, static_center, static_radius, 2)

    # OBB
    pygame.draw.polygon(screen, GREEN, obb_points, 2)

    # =========================
    # 📊 텍스트 출력
    # =========================
    aabb_text = font.render(f"AABB: {'HIT' if aabb_collision else 'MISS'}", True, RED)
    circle_text = font.render(f"Circle: {'HIT' if circle_collision else 'MISS'}", True, BLUE)
    obb_text = font.render(f"OBB: {'HIT' if obb_collision else 'MISS'}", True, GREEN)

    screen.blit(aabb_text, (10, 10))
    screen.blit(circle_text, (10, 40))
    screen.blit(obb_text, (10, 70))

    pygame.display.flip()

pygame.quit()
sys.exit()